# =============================================================================
# APP
# =============================================================================
APP_NAME="FastAPI Elastic Search"
APP_ENV=production
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO
ALLOWED_HOSTS=api.yourdomain.com,yourdomain.com
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# =============================================================================
# SECURITY
# =============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=change_me_use_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY=your_api_key_here

# =============================================================================
# MONGODB
# =============================================================================
# Use SRV format for Atlas: mongodb+srv://
MONGODB_URL=mongodb://mongodb:mongodb@localhost:27017
#Prod:  mongodb+srv://user:password@cluster0.xxxxx.mongodb.net
MONGODB_DB_NAME=noor_notes
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10
MONGODB_TIMEOUT_MS=5000

# =============================================================================
# ELASTICSEARCH
# =============================================================================
ELASTICSEARCH_URL=http://localhost:9200
# Prod:  https://your-cluster.es.io:9243
ELASTICSEARCH_INDEX=notes
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_es_password
ELASTICSEARCH_CA_CERTS=/etc/ssl/certs/es-ca.pem
ELASTICSEARCH_MAX_RETRIES=3
ELASTICSEARCH_TIMEOUT=30

# =============================================================================
# REDIS (cache / rate-limiting)
# =============================================================================
REDIS_URL=redis://:password@redis-host:6379/0
REDIS_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# SERVER
# =============================================================================
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=False

# =============================================================================
# OBSERVABILITY
# =============================================================================
SENTRY_DSN=https://xxxx@sentry.io/xxxxx
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector:4317